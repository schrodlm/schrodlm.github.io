---
// The herbarium at /herbarium/: the specimen card of every written post and note, side by side like
// labels in a museum hall, each linking to its page. A stub has no flower yet, so no card. The cards
// are in the order of their Latin names, as a herbarium files its sheets, so a genus hangs
// together; specimens of one name follow their numbers.
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import SpecimenCard from '../../components/SpecimenCard.astro';
import { withBase } from '../../lib/base-path';
import { grow } from '../../lib/herbarium';
import { isStub } from '../../lib/markdown/is-stub';
import { pagePath, seedName } from '../../lib/pages';

const pages = [...(await getCollection('posts')), ...(await getCollection('notes'))].filter(
  (page) => !isStub(page.body ?? ''),
);
const cards = pages
  .map((page) => ({
    specimen: grow(seedName(page.collection, page.id)),
    planted: 'date' in page.data ? page.data.date : undefined,
    page: {
      title: page.data.title,
      href: withBase(pagePath(page.collection, page.id), import.meta.env.BASE_URL),
      lang: page.data.lang,
    },
  }))
  .sort((a, b) => a.specimen.latin.localeCompare(b.specimen.latin, 'la') || a.specimen.seed - b.specimen.seed);
---

<Page title="Herbarium" description="Every flower that grows on this site, with its label.">
  <p class="eyebrow">Hall of flowers</p>
  <h1 lang="la">Herbarium schrodlmensis</h1>
  <p class="intro">
    Every post and note on this site grows one flower from its name, and the same name always grows the same
    flower. Here they all hang together, each with its label.
  </p>
  <div class="cards">
    {cards.map((card) => <SpecimenCard {...card} />)}
  </div>
</Page>

<style>
  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin-top: 6px;
    font-family: var(--serif);
    font-style: italic;
  }

  .intro {
    margin: 0 0 40px;
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 22px;
  }
</style>
