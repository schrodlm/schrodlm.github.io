---
// A project's page at /projects/<slug>/, the generic frame every project gets until one has a page
// designed for it: the header plate beside its name and facts, a jump bar, the write-up as written,
// the milestones, the field journal of its devlogs, and the posts that belong to it.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FieldJournal from '../../components/FieldJournal.astro';
import Milestones from '../../components/Milestones.astro';
import Plate from '../../components/Plate.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import Prose from '../../components/Prose.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { withBase } from '../../lib/base-path';
import { projectPlate } from '../../lib/plates';
import { day } from '../../lib/projects';

export async function getStaticPaths() {
  const [devlogs, posts] = await Promise.all([getCollection('devlogs'), getCollection('posts')]);
  return (await getCollection('projects')).map((project) => ({
    params: { project: project.id },
    props: {
      project,
      devlogs: devlogs.filter((devlog) => devlog.data.project.id === project.id),
      posts: posts
        .filter((post) => post.data.project?.id === project.id)
        .sort((a, b) => +b.data.date - +a.data.date),
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  devlogs: CollectionEntry<'devlogs'>[];
  posts: CollectionEntry<'posts'>[];
}

const { project, devlogs, posts } = Astro.props;
const { title, lang, description, status, languages, github, milestones } = project.data;
const { Content } = await render(project);
const link = (path: string) => withBase(path, import.meta.env.BASE_URL);

const jumps = [
  milestones.length > 0 && { href: '#milestones', text: `milestones ${milestones.filter((milestone) => milestone.done).length}/${milestones.length}` },
  devlogs.length > 0 && { href: '#journal', text: `field journal · ${devlogs.length}` },
  posts.length > 0 && { href: '#posts', text: `posts · ${posts.length}` },
].filter((jump) => jump !== false);
---

<Page title={title} description={description} lang={lang} section="projects">
  <Breadcrumb steps={[{ text: 'projects', href: '/projects/' }, { text: title }]} />
  <div class="plate">
    <Plate plate={projectPlate(project.id, 'wide')} narrow={projectPlate(project.id, 'narrow')} />
  </div>
  <h1>{title}</h1>
  <p class="description">{description}</p>
  <p class="facts">
    <span class="languages">{languages.join(', ')}</span>
    <ProjectStatus status={status} />
    {github && <a href={github}>{github.replace(/^https:\/\//, '')}</a>}
  </p>
  {
    jumps.length > 0 && (
      <nav class="jumps" aria-label="On this page">
        {jumps.map((jump) => (
          <a href={jump.href}>{jump.text}</a>
        ))}
      </nav>
    )
  }
  <div class="write-up"><Prose><Content /></Prose></div>
  {
    milestones.length > 0 && (
      <section id="milestones" class="part">
        <SectionHeading title="Milestones" />
        <Milestones milestones={milestones} />
      </section>
    )
  }
  {
    devlogs.length > 0 && (
      <section id="journal" class="part">
        <SectionHeading title="Field journal" />
        <FieldJournal devlogs={devlogs} />
      </section>
    )
  }
  {
    posts.length > 0 && (
      <section id="posts" class="part">
        <SectionHeading title="Posts" />
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <span class="date">{day(post.data.date)}</span>
              <a href={link(`/posts/${post.id}/`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Page>

<style>
  .plate {
    margin: 18px 0 28px;
  }

  h1 {
    margin-top: 0;
  }

  .description {
    margin: 0 0 14px;
    font-size: 20px;
    line-height: 1.5;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }

  .languages {
    color: var(--ink);
  }

  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 36px 0 0;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 13px;
  }

  .write-up {
    margin-top: 40px;
  }

  .part {
    scroll-margin-top: 24px;
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    padding: 4px 0;
  }

  .posts .date {
    flex: 0 0 132px;
    padding-top: 2px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>
