---
// The courses home at /courses/: my intro, a card for each university with a crop of its building,
// then an index of every course, oldest first. A course without a review is listed without a link.
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Plate from '../../components/Plate.astro';
import Prose from '../../components/Prose.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CourseName from '../../components/CourseName.astro';
import { withBase } from '../../lib/base-path';
import { courseFacts, oldestFirst, universityHref } from '../../lib/courses';
import { universityPlate } from '../../lib/plates';

const intro = await getEntry('intros', 'courses');
const Intro = intro && (await render(intro)).Content;
const title = intro?.data.title ?? 'Courses';
const courses = oldestFirst(await getCollection('courses'));
const universities = await getCollection('universities');
const shortName = new Map(universities.map(({ id, data }) => [id, data.short_name]));

// The universities in the order I attended them: by their first course, then the ones with none.
const firstCourse = (id: string) => {
  const at = courses.findIndex((course) => course.data.university.id === id);
  return at === -1 ? courses.length : at;
};
const cards = universities
  .map((university) => {
    const own = courses.filter((course) => course.data.university.id === university.id);
    return {
      university,
      href: withBase(universityHref(university.id), import.meta.env.BASE_URL),
      facts: courseFacts(own),
    };
  })
  .sort((a, b) => firstCourse(a.university.id) - firstCourse(b.university.id));
---

<Page title={title} section="courses">
  <div lang={intro?.data.lang}>
    <h1>{title}</h1>
    {Intro && <Prose><Intro /></Prose>}
  </div>

  {
    cards.length > 0 && (
      <ul class="cards">
        {cards.map(({ university, href, facts }) => (
          <li class="card">
            <a class="crop" href={href} tabindex="-1" aria-hidden="true">
              <Plate plate={universityPlate(university.id, 'narrow')} decorative />
            </a>
            <a class="uni" href={href}>
              {university.data.short_name} <span aria-hidden="true">→</span>
            </a>
            <p class="facts">{facts}</p>
            <p class="full-name" lang={university.data.lang}>
              {university.data.title}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <section>
    <SectionHeading title="All courses" />
    {courses.length === 0 ? <p class="none">No courses yet.</p> : <p class="note">oldest first</p>}
    <ul class="index">
      {
        courses.map((course) => (
          <li>
            <span class="code">{course.data.code}</span>
            <CourseName course={course} class="name" />
            <span class="when">
              {shortName.get(course.data.university.id)} · {course.data.year} {course.data.semester}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Page>

<style>
  h1 {
    margin: 0 0 22px;
  }

  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 36px 28px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 342px;
  }

  .crop {
    display: block;
  }

  /* The name is a link, or plain text for a course with no page; CourseName draws it. */
  .index :global(.name) {
    font-size: 16px;
    line-height: 1.4;
  }

  .uni {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 600;
    text-decoration: none;
  }

  .uni:hover {
    text-decoration: underline;
  }

  .facts,
  .note,
  .code,
  .when {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .facts {
    margin: 4px 0 6px;
  }

  .full-name {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
  }

  .note {
    margin: -4px 0 8px;
  }

  .none {
    color: var(--muted);
    font-style: italic;
  }

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 16px;
    padding: 5px 0;
  }

  .code {
    font-size: 13px;
  }

  .when {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .card {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .index li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .index :global(.name) {
      grid-column: 1 / 3;
      grid-row: 2;
    }
  }
</style>
