---
import Page from '../layouts/Page.astro';
import { withBase } from '../lib/base-path';
---

<Page title="Not found" description="There is no page at this address." canonical={false}>
  <p class="where">404</p>
  <h1>Nothing grows here</h1>
  <p>There is no page at this address. It may have moved, or it was never planted.</p>
  <p><a href={withBase('/', import.meta.env.BASE_URL)}>Back to the garden</a></p>
</Page>

<style>
  .where {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>
