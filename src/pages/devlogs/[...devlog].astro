---
// A devlog at /devlogs/<path>/, the address the converter links it by: its path below devlogs/,
// such as /devlogs/rentczecher/session-3/. Close to a note, with the note's vine beside the text
// but no flower. Under the title, a breadcrumb back to the field journal, the session trail, then
// the Summary as the lede, the Goal in a box, a line counting each section's items, the sections
// with a marker before each item, the references, and the previous and next sessions.
import { getCollection, type CollectionEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Prose from '../../components/Prose.astro';
import SessionTrail from '../../components/SessionTrail.astro';
import Vine from '../../components/Vine.astro';
import { withBase } from '../../lib/base-path';
import { KINDS, gist, sections } from '../../lib/devlog';
import { day, inOrder } from '../../lib/projects';

export async function getStaticPaths() {
  const [devlogs, projects] = await Promise.all([getCollection('devlogs'), getCollection('projects')]);
  return devlogs.map((devlog) => ({
    params: { devlog: devlog.id },
    props: {
      devlog,
      project: projects.find((project) => project.id === devlog.data.project.id)!,
      sessions: inOrder(devlogs.filter((other) => other.data.project.id === devlog.data.project.id)),
    },
  }));
}

interface Props {
  devlog: CollectionEntry<'devlogs'>;
  project: CollectionEntry<'projects'>;
  /** Every session of the project, in order. */
  sessions: CollectionEntry<'devlogs'>[];
}

const { devlog, project, sessions } = Astro.props;
const { title, lang, date, session, prs, tags } = devlog.data;
const link = (path: string) => withBase(path, import.meta.env.BASE_URL);
const journal = link(`/projects/${project.id}/#journal`);
const current = sessions.findIndex((other) => other.id === devlog.id);
const [previous, next] = [sessions[current - 1], sessions[current + 1]];

const html = devlog.rendered?.html ?? '';
const { intro, sections: all } = sections(html);
const summary = all.find((section) => section.id === 'summary');
const goal = all.find((section) => section.id === 'goal');
const references = all.find((section) => section.id === 'references');
const body = all.filter((section) => section !== summary && section !== goal && section !== references);
// The page's description, for search and links shared elsewhere.
const description = gist(html, lang);
const counted = body.filter((section) => KINDS.has(section.id) && section.items > 0);

/** A pull request's address, written as its number when it has one. */
function prText(url: string) {
  const number = /\/pull\/(\d+)\/?$/.exec(url)?.[1];
  return number ? `#${number}` : url;
}
---

<Page title={title} {...(description && { description })} lang={lang} section="projects">
  <Vine slot="side" />
  <Breadcrumb
    steps={[
      { text: 'projects', href: '/projects/' },
      { text: project.data.title, href: `/projects/${project.id}/` },
      { text: 'field journal', href: `/projects/${project.id}/#journal` },
    ]}
  />
  <h1>{title}</h1>
  <p class="meta">
    <span class="ink">{day(date)}</span>
    <span>
      · session <span class="ink">{session}</span> of {sessions.at(-1)!.data.session}
    </span>
    {
      prs.length > 0 && (
        <span>
          · {prs.length === 1 ? 'PR' : 'PRs'}{' '}
          {prs.map((url, i) => (
            <>
              {i > 0 && ', '}
              <a href={url}>{prText(url)}</a>
            </>
          ))}
        </span>
      )
    }
    {tags.length > 0 && <span>· {tags.map((tag) => `#${tag}`).join(' ')}</span>}
  </p>
  <SessionTrail project={project.data.title} sessions={sessions} current={current} />
  <Prose>
    {intro && <Fragment set:html={intro} />}
    {summary && <div id="summary" class="lede" set:html={summary.html} />}
    {
      goal && (
        <div id="goal" class="goal">
          <span class="label">Goal</span>
          <div class="goal-text" set:html={goal.html} />
        </div>
      )
    }
    {
      counted.length > 0 && (
        <nav class="counts" aria-label="Sections">
          <span>in this session:</span>
          {counted.map((section) => (
            <a href={`#${section.id}`}>
              {KINDS.get(section.id)!.short} {section.items}
            </a>
          ))}
        </nav>
      )
    }
    {
      body.map((section) => {
        const marker = KINDS.get(section.id)?.marker;
        return (
          <section class="section" data-marker={marker} style={marker && `--marker: '${marker}'`}>
            <h2 id={section.id}>
              <span set:html={section.heading} />
              {marker && section.items > 0 && <span class="count">{section.items}</span>}
              <span class="leader" aria-hidden="true">
                {'.'.repeat(120)}
              </span>
            </h2>
            <Fragment set:html={section.html} />
          </section>
        );
      })
    }
    {
      references && (
        <div id="references" class="references">
          <span class="label">References</span>
          <Fragment set:html={references.html} />
        </div>
      )
    }
  </Prose>
  {
    (previous || next) && (
      <nav class="neighbours" aria-label="Previous and next session">
        {previous && (
          <a class="previous" href={link(`/devlogs/${previous.id}/`)}>
            <span class="which">
              &lt;- session {previous.data.session} · {day(previous.data.date)}
            </span>
            <span class="name">{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="next" href={link(`/devlogs/${next.id}/`)}>
            <span class="which">
              session {next.data.session} -&gt; · {day(next.data.date)}
            </span>
            <span class="name">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
  <p class="back"><a href={journal}>back to {project.data.title}'s field journal</a></p>
</Page>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 0 0 32px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .ink {
    color: var(--ink);
  }

  .lede {
    margin-bottom: 30px;
    font-size: 21px;
    line-height: 1.6;
  }

  .lede :global(p:last-child) {
    margin-bottom: 0;
  }

  .goal {
    display: flex;
    gap: 16px;
    margin-bottom: 18px;
    padding: 16px 20px;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .label {
    flex: 0 0 auto;
    padding-top: 4px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .goal-text {
    flex: 1;
    min-width: 0;
  }

  .goal-text :global(> :last-child) {
    margin-bottom: 0;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .section {
    margin-top: 52px;
  }

  .section h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 16px;
  }

  .count {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }

  .leader {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: pre;
    font-size: 13px;
    font-weight: 400;
    color: var(--rule);
  }

  /* Each item of a section with a marker carries it in place of the bullet: [x] for done, -> for a
     decision, ! for a problem, + for a lesson, [ ] for what is next. A task keeps its own box. */
  .section[data-marker] > :global(:is(ul, ol)) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 40px;
    list-style: none;
  }

  .section[data-marker] > :global(:is(ul, ol) > li) {
    position: relative;
    margin: 0;
  }

  .section[data-marker] > :global(:is(ul, ol) > li:not(.task-list-item))::before {
    content: var(--marker);
    position: absolute;
    left: -40px;
    width: 28px;
    padding-top: 2px;
    font-family: var(--mono);
    font-size: 14px;
    white-space: pre;
    color: var(--canopy);
  }

  .section[data-marker] > :global(:is(ul, ol) > li > :is(.task-box, p:first-child > .task-box)) {
    position: absolute;
    left: -40px;
    padding-top: 2px;
  }

  .references {
    margin-top: 52px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }

  .references .label {
    display: block;
    margin-bottom: 6px;
  }

  .neighbours {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 56px;
  }

  .neighbours a {
    display: block;
    flex: 1 1 260px;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    background: var(--paper);
    text-decoration: none;
  }

  .next {
    text-align: right;
  }

  .which {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .name {
    display: block;
    margin-top: 4px;
    font-size: 17px;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .back {
    margin: 22px 0 0;
    font-family: var(--mono);
    font-size: 13px;
  }
</style>
