---
// The About page's words: the body of its note in the vault, or, until that note exists, a line
// saying the words are still to come.
import { render, type CollectionEntry } from 'astro:content';
import Prose from './Prose.astro';

interface Props {
  entry: CollectionEntry<'about'> | undefined;
}

const { entry } = Astro.props;
const Content = entry && (await render(entry)).Content;
---

<div class="words">
  {Content ? <Prose><Content /></Prose> : <p class="to-come">The words for this page are still to come.</p>}
</div>

<style>
  .words {
    margin-top: 56px;
  }

  .to-come {
    color: var(--muted);
    font-style: italic;
  }
</style>
