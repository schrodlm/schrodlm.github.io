---
// A section heading and the short vine it trails across the rest of the column. Subheadings are
// plain <h3>s and trail nothing. Its styles are in garden.css.
import { trail } from '../lib/trail';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="section-heading">
  <h2>{title}</h2>
  <span class="trail" aria-hidden="true">{trail(title).map((run) => <span class={run.part}>{run.text}</span>)}</span>
</div>

