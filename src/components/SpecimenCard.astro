---
// The specimen card that closes a note or a post, like a museum label: the page's flower drawn
// again, its specimen number and Latin name, the name it grew from, and the traits its seed chose.
// In the herbarium, where cards hang side by side, each also names its page and links to it.
import Braille from './Braille.astro';
import { isoDay } from '../lib/pages';
import { draw, label, type Specimen } from '../lib/herbarium';

interface Props {
  specimen: Specimen;
  // The day a post was published; a note has none.
  planted?: Date | undefined;
  // The page the flower grew on, for a card hung in the herbarium rather than at the page's end.
  page?: { title: string; href: string; lang: string };
}

const { specimen, planted, page } = Astro.props;
// Each trait's name is followed by dots out to one width, so the values line up as on a label.
const key = (name: string) => `${name} ${'.'.repeat(Math.max(2, 9 - name.length))}`;
---

{/* In the herbarium a card is one of many, so it doesn't make itself a landmark. */}
<section class:list={['card', { hung: page }]} aria-label={page ? undefined : "This page's flower"}>
  <Braille rows={draw(specimen, { wind: 0, form: 'plant' })} />
  <div class="label">
    <p class="number">Specimen No. {specimen.seed} · Herbarium schrodlmensis</p>
    <p class="latin" lang="la">{specimen.latin}</p>
    {
      page && (
        <p class="page">
          “<a href={page.href} lang={page.lang}>{page.title}</a>”
        </p>
      )
    }
    <p class="grown">grown from “{specimen.name}”{planted && ` · planted ${isoDay(planted)}`}</p>
    <dl>
      {
        label(specimen).map((trait) => (
          <div>
            <dt>{key(trait.name)}</dt>
            <dd>{trait.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 18px 32px;
    margin-top: 64px;
    padding: 24px 28px;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  /* In the herbarium the cards stand in rows, with no text above them to keep clear of; a card
     stretched to its row's height keeps its flower and label at the top. */
  .hung {
    align-content: flex-start;
    margin-top: 0;
  }

  .label {
    flex: 1 1 280px;
    min-width: 0;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.65;
  }

  p,
  dl,
  dd {
    margin: 0;
  }

  .number {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .latin {
    margin: 4px 0 2px;
    font-family: var(--serif);
    font-size: 24px;
    font-style: italic;
    line-height: 1.3;
  }

  .page {
    font-size: 14px;
  }

  .grown {
    margin-bottom: 12px;
    color: var(--muted);
  }

  dl > div {
    display: flex;
    gap: 10px;
  }

  dt {
    color: var(--muted);
    white-space: pre;
  }
</style>
